// Test: dk0 -I etc/dk/v --trust-local-package CommonsBase_Dk get-object CommonsBase_Dk.ProtoCheck@0.0.1 -s Release.Windows_x86_64 -d target/proto
//
// Drives the Proto rule: post-object a Leaf, then a Dep that depends on Leaf.
// If proof.txt is produced, then post-object -> post-object via merge-object works.
{
    "$schema": "https://diskuv.com/dk/schema/dk-value-1.0.json",
    "schema_version": { "major": 1, "minor": 0 },
    "forms": [
        {
            "id": "CommonsBase_Dk.ProtoCheck@0.0.1",
            "precommands": {
                "sequential": true,
                "private": [
                    "run-function CommonsBase_Dk.Proto.F_Proto@0.0.1 -d t/leaf modver=CommonsBase_Dk.Proto.Leaf@0.0.1 name=leaf",
                    "run-function CommonsBase_Dk.Proto.F_Proto@0.0.1 -d t/dep modver=CommonsBase_Dk.Proto.Dep@0.0.1 name=dep dep=CommonsBase_Dk.Proto.Leaf@0.0.1"
                ]
            },
            "function": {
                "commands": [
                    [
                        "$(get-object CommonsBase_Std.Coreutils@0.6.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
                        "cp",
                        "t/dep/merged-leaf.txt",
                        "${SLOT.request}/proof.txt"
                    ]
                ]
            },
            "outputs": {
                "assets": [
                    { "slots": ["Release.Windows_x86_64"], "paths": ["proof.txt"] }
                ]
            }
        }
    ]
}
