// CommonsBase_Dk.TestPkg.LockSrc@2.4.3 -- the with-test opam lock as a standalone
// object, used as the TestPkg closure's OpamBuild localsrc=.
//
// The TestPkg closure builds only EXTERNAL opam packages (it was generated
// skiplocal=t), so -- unlike the Dk0/Dk1 runtime closures, which build in-tree
// dk0 packages and therefore need MlFrontSource's output.zip -- it consumes its
// localsrc ONLY for the lock file (OpamBuild reads output.zip from localsrc just
// `if is_local`; every external package fetches its own source from the lock's
// URLs). So this object exposes only the lock.
//
// For now the lock is the workspace asset CommonsBase_Dk.TestPkgLock.Lock
// (assets/testpkg/dk-opam-lock-test.jsonc; see dk.u), not the copy inside
// MlFrontSource's output.zip at mlfront/dk.opam-lock-test.jsonc. At the next
// normal repin this goes back to extracting it from MlFrontSource. It is
// republished as the top-level dk-opam-lock-test.jsonc member (dash form,
// mirroring how MlFrontSource copies out dk-opam-lock.jsonc). Keeping the lock
// out of MlFrontSource itself keeps the Dk0/Dk1 value-ids (which descend from
// MlFrontSource) unperturbed: a test-only closure must not re-address the
// shipping runtime binaries. Copying is pure file I/O, so output is
// host-independent and each slot produces it identically.
{
  "$schema": "https://diskuv.com/dk/schema/dk-value-1.0.json",
  "schema_version": { "major": 1, "minor": 0 },
  "forms": [
    {
      "id": "CommonsBase_Dk.TestPkg.LockSrc@2.4.3",
      "function": {
        "commands": [
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "mkdir", "-p", "${SLOT.request}"
          ],
          // Publish the lock under the top-level dash-form member name the
          // TestPkg closure reads via locksrcpath=./dk-opam-lock-test.jsonc.
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp",
            "$(get-asset CommonsBase_Dk.TestPkgLock.Lock@2.4.3 -p assets/testpkg/dk-opam-lock-test.jsonc -f dk.opam-lock-test.jsonc)",
            "${SLOT.request}/dk-opam-lock-test.jsonc"
          ]
        ]
      },
      "outputs": {
        "assets": [
          {
            "slots": [
              "Release.Windows_x86_64", "Release.Windows_x86",
              "Release.Linux_x86_64", "Release.Linux_x86_64_musl",
              "Release.Linux_x86", "Release.Linux_arm64",
              "Release.Darwin_x86_64", "Release.Darwin_arm64"
            ],
            "paths": [ "dk-opam-lock-test.jsonc" ]
          }
        ]
      }
    }
  ]
}
