// R2b prototype: build the protoapp dune executable as a dk object that
// depends on protolib. Stage protolib's install.zip (the Proto2Build object)
// into p/ via get-object + 7zz, point OCAMLPATH at p/lib, and let dune resolve
// the dependency (DkML has no findlib; dune reads OCAMLPATH + dune-package
// directly, so no findlib.conf is needed for a dune consumer).
// Test: dk0 -I etc/dk/v --trust-local-package CommonsBase_Dk get-object CommonsBase_Dk.Proto2App@0.0.1 -s Release.Windows_x86_64 -d target/proto2app
{
    "$schema": "https://diskuv.com/dk/schema/dk-value-1.0.json",
    "schema_version": { "major": 1, "minor": 0 },
    "forms": [
        {
            "id": "CommonsBase_Dk.Proto2App@0.0.1",
            "function": {
                "execution": [ { "name": "OSFamily", "value": "windows" } ],
                "envmods": [
                    "<PATH=$(--path=absnative get-object CommonsLang_OCaml.DkML.Win32@4.14.3 -s Release.Windows_x86_64 -d : -e 'bin/*')${/}bin",
                    "<PATH=$(--path=absnative get-object CommonsLang_OCaml.Dune@3.23.1 -s Release.Windows_x86_64 -d : -e 'bin/*')${/}bin",
                    "<PATH=$(--path=absnative get-object CommonsBase_GNU.Toolchain.W64dev@2.5.0 -s Release.execution_abi -d : -e 'bin/*')${/}bin"
                ],
                "commands": [
                    [
                        "$(get-object CommonsBase_Std.Coreutils@0.6.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
                        "mkdir",
                        "-p",
                        "s"
                    ],
                    [
                        "$(get-object CommonsBase_Std.Coreutils@0.6.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
                        "mkdir",
                        "-p",
                        "${CACHEABS}/p"
                    ],
                    [
                        "$(get-object CommonsBase_Std.Coreutils@0.6.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
                        "env",
                        "--chdir",
                        "${CACHEABS}/p",
                        "$(get-object CommonsBase_Std.S7z@25.1.0 -s Release.execution_abi -e '*' -d :)/7zz.exe",
                        "x",
                        "$(--path=absnative get-object CommonsBase_Dk.Proto2Build@0.0.1 -s ${SLOTNAME.request} -e install.zip -d :)${/}install.zip",
                        "-y"
                    ],
                    [
                        "$(--path=absnative get-object CommonsBase_GNU.Toolchain.W64dev@2.5.0 -s Release.execution_abi -e bin/tar.exe -d :)${/}bin${/}tar.exe",
                        "xzf",
                        "$(--path=absnative get-asset CommonsBase_Dk.Apparatus.Proto2AppSrc@1.0.0 -p assets/proto2app-src.tar.gz -f proto2app-src.tar.gz)",
                        "-C",
                        "s"
                    ],
                    [
                        "--cmd.exe",
                        "/c",
                        "\"`\"s${/}proto2app-build.bat`\" `\"$(--path=absnative get-object CommonsBase_Build.VSWhere@3.1.7 -s Release.execution_abi -e bin/vswhere.exe -d :)${/}bin${/}vswhere.exe`\" x64 `\"${CACHEABS}${/}p${/}lib`\" `\"${SLOTABS.Release.Windows_x86_64}`\"\""
                    ]
                ]
            },
            "outputs": {
                "assets": [
                    { "slots": ["Release.Windows_x86_64"], "paths": ["protoapp.exe"] }
                ]
            }
        }
    ]
}
