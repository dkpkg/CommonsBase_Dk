        "base-unix",
        "base-bigarray",
        "base-threads",
        "arch-x86_64",
        "system-mingw",
        "ocaml-options-vanilla",
        "flexdll"
      ],
      "depends_raw": "\"ocaml\" {= \"4.14.4\" & post}\r\n\"base-unix\" {post}\r\n\"base-bigarray\" {post}\r\n\"base-threads\" {post}\r\n((\"arch-x86_64\" {os = \"win32\" & arch = \"x86_64\"} &\r\n  (\"system-mingw\" | \"system-msvc\")) |\r\n (\"arch-x86_32\" {os = \"win32\"} & (\"system-mingw\" | \"system-msvc\")) |\r\n \"base-unix\" {os != \"win32\" & post})\r\n\"ocaml-options-vanilla\" {post}\r\n\"flexdll\" {>= \"0.36\" & os = \"win32\"}",
      "install": "make \"install\"",
